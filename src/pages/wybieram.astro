---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allRecipes = await getCollection('recipes');
const recipesData = allRecipes.map((entry) => ({
  slug: entry.slug,
  title: entry.data.title,
  image: entry.data.image ?? null,
  timeMinutes: entry.data.time_minutes,
  calories: entry.data.calories,
  slots: entry.data.slots,
  ingredients: entry.data.ingredients,
}));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Wybieram — Jutro jem">
  <div class="min-h-dvh bg-emalia-900 text-na-emalii flex flex-col p-4">
    <div class="max-w-2xl mx-auto w-full">
      <a
        data-testid="close-picker"
        aria-label="Zamknij tryb wybierania"
        href={`${base}/plan`}
        class="inline-flex items-center min-h-touch font-semibold text-na-emalii-2 hover:text-na-emalii"
      >
        ← Zamknij tryb wybierania
      </a>

      <h1 class="text-2xl font-ui font-bold mt-4 mb-1">Wybieram</h1>
      <p class="text-na-emalii-2 mb-1">
        Dzień: <strong data-testid="picker-date">…</strong>
        <span data-testid="picker-slot-wrap"> · Slot: <strong data-testid="picker-slot">…</strong></span>
      </p>
      <p data-testid="slot-filter-note" class="text-sm text-kurkuma mb-4">
        Pokaż wszystkie przepisy
      </p>

      <div id="deck" class="relative" aria-live="polite"></div>

      <p id="deck-empty" hidden class="text-na-emalii-2 mt-4">
        Obejrzano już wszystkie przepisy z puli przepisów. Wróć później po więcej.
      </p>

      <p id="deck-confirm" hidden data-testid="deck-confirm" class="mt-4 text-kurkuma font-semibold">
        Zaplanowany! Dodany do planu dnia.
      </p>

      <div class="mt-4 flex flex-wrap gap-2">
        <button
          type="button"
          data-testid="deck-no"
          class="inline-flex items-center justify-center min-h-touch px-6 py-3 rounded-l border border-white/30 font-bold"
        >
          Nie dziś
        </button>
        <button
          type="button"
          data-testid="deck-yes"
          class="inline-flex items-center justify-center min-h-touch px-6 py-3 rounded-l bg-kurkuma text-emalia-900 font-bold"
        >
          Biorę
        </button>
        <button
          type="button"
          data-testid="deck-undo"
          disabled
          class="inline-flex items-center justify-center min-h-touch px-6 py-3 rounded-l border border-white/30 font-semibold disabled:opacity-40"
        >
          Cofnij ostatnią decyzję
        </button>
      </div>
    </div>
  </div>

  <script id="recipes-data" type="application/json" set:html={JSON.stringify(recipesData)} />

  <script>
    import { getDateParam, getSlotParam, buildPlanUrl, getRecipesData } from '../scripts/router.ts';

    const VALID_SLOTS = ['sniadanie', 'drugie-sniadanie', 'obiad', 'kolacja', 'deser'];

    const date = getDateParam();
    const slot = getSlotParam();

    document.querySelectorAll('[data-testid="picker-date"]').forEach((el) => {
      el.textContent = date;
    });
    document.querySelectorAll('[data-testid="picker-slot"]').forEach((el) => {
      el.textContent = slot || 'wszystkie';
    });

    const close = document.querySelector('[data-testid="close-picker"]');
    if (close instanceof HTMLAnchorElement) {
      close.href = buildPlanUrl(date);
    }

    // ——— Minimalna talia kart (E-04 zalążek; pełna mechanika w kroku 1.1) ———
    const recipes = getRecipesData();
    const pool = VALID_SLOTS.includes(slot)
      ? recipes.filter((r) => r.slots.includes(slot))
      : recipes;
    const queue = pool.length > 0 ? [...pool] : [...recipes];

    const deck = document.getElementById('deck');
    const emptyMsg = document.getElementById('deck-empty');
    const confirmMsg = document.getElementById('deck-confirm');
    const noBtn = document.querySelector('[data-testid="deck-no"]');
    const yesBtn = document.querySelector('[data-testid="deck-yes"]');
    const undoBtn = document.querySelector('[data-testid="deck-undo"]');

    // Historia decyzji do cofania: { recipe, decision: 'yes' | 'no' }
    const history: Array<{ recipe: (typeof queue)[number]; decision: 'yes' | 'no' }> = [];

    function refreshUndo() {
      if (undoBtn instanceof HTMLButtonElement) {
        undoBtn.disabled = history.length === 0;
      }
    }

    function current() {
      return queue[0] ?? null;
    }

    function renderCard() {
      if (!deck) return;
      deck.innerHTML = '';
      const recipe = current();
      if (emptyMsg instanceof HTMLElement) emptyMsg.hidden = recipe !== null;
      if (!recipe) return;

      const card = document.createElement('article');
      card.id = 'card-current';
      card.setAttribute('aria-label', recipe.title);
      card.className = 'bg-biel text-ink rounded-l p-5 shadow-cien-2 touch-pan-y select-none';
      card.tabIndex = 0;

      const title = document.createElement('h2');
      title.className = 'text-xl font-bold';
      title.textContent = recipe.title;
      card.appendChild(title);

      const meta = document.createElement('p');
      meta.className = 'text-sm text-ink-2 mt-1';
      meta.textContent = `${recipe.timeMinutes} minut · ${recipe.calories} kcal`;
      card.appendChild(meta);

      deck.appendChild(card);
      attachDrag(card);
    }

    function saveToPlan(recipeSlug: string) {
      try {
        const KEY = 'jutrojem:plan';
        const raw = localStorage.getItem(KEY);
        const plan = raw ? JSON.parse(raw) : null;
        const base2 =
          plan && plan.date === date && Array.isArray(plan.slots) && plan.slots.length > 0
            ? plan
            : { date, slots: [{ id: 'slot-obiad', name: 'obiad', label: 'Obiad', dishes: [] }] };
        base2.slots[0].dishes.push({ recipeSlug, addedAt: Date.now() });
        localStorage.setItem(KEY, JSON.stringify(base2));
      } catch { /* podgląd bez zapisu */ }
    }

    function showConfirm() {
      if (confirmMsg instanceof HTMLElement) confirmMsg.hidden = false;
    }

    function accept() {
      const recipe = current();
      if (!recipe) return;
      history.push({ recipe, decision: 'yes' });
      saveToPlan(recipe.slug);
      showConfirm();
      queue.shift();
      renderCard();
      refreshUndo();
    }

    function reject() {
      const recipe = current();
      if (!recipe) return;
      history.push({ recipe, decision: 'no' });
      queue.shift();
      renderCard();
      refreshUndo();
    }

    function undo() {
      const last = history.pop();
      if (!last) return;
      queue.unshift(last.recipe);
      renderCard();
      refreshUndo();
    }

    noBtn?.addEventListener('click', reject);
    yesBtn?.addEventListener('click', accept);
    undoBtn?.addEventListener('click', undo);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        accept();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        reject();
      } else if (e.key === 'Backspace') {
        e.preventDefault();
        undo();
      }
    });

    // Przeciągnięcie karty (mysz / dotyk): w prawo = biorę, w lewo = nie dziś.
    function attachDrag(card: HTMLElement) {
      let startX: number | null = null;
      let startY: number | null = null;

      const onDown = (x: number, y: number) => { startX = x; startY = y; };
      const onUp = (x: number, y: number) => {
        if (startX === null || startY === null) return;
        const cardEl = document.getElementById('card-current');
        const width = cardEl?.getBoundingClientRect().width ?? 300;
        const dx = x - startX;
        const dy = y - startY;
        startX = null; startY = null;
        if (Math.abs(dy) > Math.abs(dx)) return; // pionowy scroll — ignoruj
        if (dx > width * 0.28) accept();
        else if (dx < -width * 0.28) reject();
      };

      card.addEventListener('pointerdown', (e) => onDown(e.clientX, e.clientY));
      window.addEventListener('pointerup', (e) => {
        if (startX !== null) onUp(e.clientX, e.clientY);
      });
      card.addEventListener('touchstart', (e) => {
        const t = e.changedTouches[0];
        if (t) onDown(t.clientX, t.clientY);
      }, { passive: true });
      card.addEventListener('touchend', (e) => {
        const t = e.changedTouches[0];
        if (t) onUp(t.clientX, t.clientY);
      });
    }

    renderCard();
    refreshUndo();
  </script>
</Base>

---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allRecipes = await getCollection('recipes');
const recipesData = allRecipes.map((entry) => ({
  slug: entry.slug,
  title: entry.data.title,
  image: entry.data.image ?? null,
  timeMinutes: entry.data.time_minutes,
  calories: entry.data.calories,
  slots: entry.data.slots,
}));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Wybieram — Jutro jem">
  <div class="min-h-dvh bg-emalia-900 text-na-emalii flex flex-col p-4">
    <div class="max-w-2xl mx-auto w-full">
      <a
        data-testid="close-picker"
        aria-label="Zamknij tryb wybierania"
        href={`${base}/plan`}
        class="inline-flex items-center min-h-touch font-semibold text-na-emalii-2 hover:text-na-emalii"
      >
        ← Zamknij tryb wybierania
      </a>

      <h1 class="text-2xl font-ui font-bold mt-4 mb-1">Wybieram</h1>
      <p class="text-na-emalii-2 mb-1">
        Dzień: <strong data-testid="picker-date">…</strong>
        <span data-testid="picker-slot-wrap"> · Slot: <strong data-testid="picker-slot">…</strong></span>
      </p>
      <p data-testid="slot-filter-note" class="text-sm text-kurkuma mb-4">
        Pokaż wszystkie przepisy
      </p>

      <p class="text-na-emalii-2">Wkrótce: karty przepisów do wybierania.</p>
    </div>
  </div>

  <script id="recipes-data" type="application/json" set:html={JSON.stringify(recipesData)} />

  <script>
    import { getDateParam, getSlotParam, buildPlanUrl } from '../scripts/router.ts';

    const date = getDateParam();
    const slot = getSlotParam();

    document.querySelectorAll('[data-testid="picker-date"]').forEach((el) => {
      el.textContent = date;
    });
    document.querySelectorAll('[data-testid="picker-slot"]').forEach((el) => {
      el.textContent = slot || 'wszystkie';
    });

    const close = document.querySelector('[data-testid="close-picker"]');
    if (close instanceof HTMLAnchorElement) {
      close.href = buildPlanUrl(date);
    }
  </script>
</Base>

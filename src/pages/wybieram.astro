---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

// Przepisy załadowane w buildzie — przekazane do Island przez JSON
const allRecipes = await getCollection('recipes');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string | undefined) =>
  path ? (base ? `${base}${path}` : path) : undefined;

// Fragmenty treści Markdown: opis (pierwszy akapit przed nagłówkami) i kroki "Przygotowanie"
function extractBody(body: string) {
  const lines = body.split('\n').map((l) => l.trim());
  const description = lines.find((l) => l.length > 0 && !l.startsWith('#') && !l.startsWith('-'));
  const steps: string[] = [];
  let inSteps = false;
  for (const line of lines) {
    if (line.startsWith('##')) {
      inSteps = true;
      continue;
    }
    if (inSteps && /^\d+\./.test(line)) {
      steps.push(line.replace(/^\d+\.\s*/, ''));
    }
  }
  return {
    description: (description ?? '').replace(/\s+/g, ' ').slice(0, 160),
    steps,
  };
}

const recipesJson = JSON.stringify(
  allRecipes.map((e) => ({
      slug: e.slug,
      title: e.data.title,
      image: withBase(e.data.image),
      timeMinutes: e.data.time_minutes,
      calories: e.data.calories,
      slots: e.data.slots,
      ingredients: e.data.ingredients,
      ...extractBody(e.body),
    })),
);
---

<!-- E-04 jest pełnoekranowy i CIEMNY — nie używa App.astro z NavBar -->
<Base title="Wybierz przepis — Jutro jem">
  <div id="cards-root" class="min-h-dvh bg-emalia-900">
    <!-- Dane dla Island -->
    <script id="all-recipes" type="application/json" set:html={recipesJson} />
    <!-- Island -->
    <div id="cards-mount"></div>
  </div>
</Base>

<script src="../components/RecipeCards.ts"></script>

---
export interface Props {
  slug: string;
  title: string;
  image?: string;
  calories?: number;
  tags?: string[];
}
const { slug, title, image, calories, tags = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const imageSrc = image
  ? (image.startsWith('/') ? `${base}${image}` : `${base}/images/${image}`)
  : null;
---
<a
  href={`${base}/przepis/${slug}`}
  class="block bg-biel rounded-m overflow-hidden shadow-[var(--cien-1)] hover:shadow-[var(--cien-2)] transition-shadow"
>
  {imageSrc && (
    <div class="aspect-[4/3] overflow-hidden bg-kreska">
      <img
        src={imageSrc}
        alt={title}
        class="w-full h-full object-cover"
        loading="lazy"
      />
    </div>
  )}
  <div class="p-3">
    <h3 class="font-ui font-semibold text-sm text-ink leading-snug">{title}</h3>
    {calories && (
      <p class="text-xs text-ink-2 mt-1">{calories} kcal</p>
    )}
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1 mt-2">
        {tags.map((tag) => (
          <span class="text-xs bg-kurkuma-tint text-kurkuma-tekst px-2 py-0.5 rounded-s font-medium">
            {tag}
          </span>
        ))}
      </div>
    )}
  </div>
</a>
